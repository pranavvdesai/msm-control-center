{
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/cron/birthdays",
      "schedule": "29 18 * * *"
    },
    {
      "path": "/api/cron/daily-play",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/daily-news",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/weekly-leave-report",
      "schedule": "30 11 * * 6"
    }
  ]
}
